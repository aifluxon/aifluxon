from collections.abc import Callable
from typing import Any

class NativeAgent:
    def __init__(
        self,
        provider_spec: str,
        store_path: str | None = None,
        policy_callback: Callable[..., str] | None = None,
        max_model_rounds: int = 32,
        max_tool_invocations: int = 64,
        oauth_provider: Any | None = None,
    ) -> None: ...
    def provider_id(self) -> str: ...
    def model(self) -> str: ...
    def capabilities(self) -> str: ...
    def register_tool(
        self, descriptor_json: str, callback: Callable[[str], str]
    ) -> None: ...
    def register_web_tools(self, base_url: str, api_key: str) -> None: ...
    def tool_descriptors(self) -> str: ...
    def start_request(self, request_json: str) -> str: ...
    def release_run(self, run_id: str) -> None: ...
    def next_event(self, run_id: str) -> str | None: ...
    def cancel(self, run_id: str) -> None: ...
    def snapshot(self, run_id: str) -> str: ...
    def resolve_operation(
        self, run_id: str, operation_id: str, decision_json: str
    ) -> None: ...
    def commit_operation(self, run_id: str, operation_id: str) -> None: ...
    def create_session(self) -> str: ...
    def open_session(self, session_id: str) -> str: ...
    def open_or_create_session(self, session_id: str) -> str: ...
    def list_sessions(self) -> str: ...
    def delete_session(self, session_id: str) -> None: ...
    def start(
        self,
        prompt: str,
        session_id: str | None = None,
        features_json: str | None = None,
        system_prompt: str | None = None,
    ) -> str: ...
    def start_with_content(
        self,
        content_json: str,
        session_id: str | None = None,
        features_json: str | None = None,
        system_prompt: str | None = None,
    ) -> str: ...

class NativeSystemKeyringStore:
    def __init__(self, service_name: str = "AIFLUXON") -> None: ...
    @property
    def service_name(self) -> str: ...

class NativeMemorySecretStore:
    def __init__(self) -> None: ...

class NativeEncryptedFileSecretStore:
    def __init__(self, path: str) -> None: ...
    @property
    def path(self) -> str: ...
    @property
    def is_unlocked(self) -> bool: ...
    def unlock(self, password: str) -> None: ...
    def lock(self) -> None: ...

class NativeCodexAuth:
    def __init__(self, secret_store: Any | None = None) -> None: ...
    def login(self) -> NativeCodexLoginAttempt: ...
    def accounts(self) -> str: ...
    def status(self, account_id: str) -> str: ...
    def refresh(self, account_id: str) -> str: ...
    def logout(self, account_id: str) -> None: ...
    def provider(self, model: str, account_id: str | None) -> NativeCodexProvider: ...
    def seed_account(
        self, account_id: str, access_token: str, refresh_token: str, id_token: str
    ) -> str: ...

class NativeCodexLoginAttempt:
    @property
    def authorization_url(self) -> str: ...
    def wait(self) -> str: ...
    def cancel(self) -> None: ...

class NativeCodexProvider:
    @property
    def provider_id(self) -> str: ...
    @property
    def model(self) -> str: ...
    @property
    def account_id(self) -> str: ...
    def spec_json(self) -> str: ...
